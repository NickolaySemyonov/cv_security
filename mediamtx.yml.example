rtspTransports: [tcp]

rtspAddress: :8554
hlsAddress: :8888

# for real rtsp streams
paths:
  camera_1:
    source: rtsp://USER:PASSWORD@CAMERA_IP:PORT/live
    rtspTransport: tcp 
  camera_2:
    source: rtsp://USER:PASSWORD@CAMERA_IP:PORT/live
    rtspTransport: tcp 
  camera_3:
    source: rtsp://USER:PASSWORD@CAMERA_IP:PORT/live
    rtspTransport: tcp
  camera_4:
    source: rtsp://USER:PASSWORD@CAMERA_IP:PORT/live
    rtspTransport: tcp

